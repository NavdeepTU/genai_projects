# Environment variables (never commit real secrets)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js (frontend, planned)
node_modules/
.next/
out/
dist/
build/

# Docker / data volumes
*.log
.docker/

# OS / editor
.DS_Store
.vscode/
.idea/

# Terraform (state files and .tfvars can both contain real secrets —
# .terraform.lock.hcl is NOT listed here on purpose, same reasoning as
# uv.lock: it pins exact provider versions and should be committed)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
!infra/terraform.tfvars.example
infra/tfplan*

# One-off, hand-run schema migrations (this project's no-Alembic
# convention — I write the exact SQL, you run it yourself once against
# your own database; the ADR is the durable record, not the file)
scripts/*.sql

# Graphify's generated codebase graph — regenerable local tooling
# output (a knowledge graph over this repo, used to cut down how much
# of the codebase Claude has to read per session), not source
graphify-out/
