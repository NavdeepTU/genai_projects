# Environment variables (never commit real secrets)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js (frontend, planned)
node_modules/
.next/
out/
dist/
build/

# Docker / data volumes
*.log
.docker/

# OS / editor
.DS_Store
.vscode/
.idea/

# Terraform (state files and .tfvars can both contain real secrets —
# .terraform.lock.hcl is NOT listed here on purpose, same reasoning as
# uv.lock: it pins exact provider versions and should be committed)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/terraform.tfvars
!infra/terraform.tfvars.example
