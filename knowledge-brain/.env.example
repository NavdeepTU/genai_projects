ENVIRONMENT=dev
DATABASE_URL=postgresql+asyncpg://knowledge_brain:knowledge_brain@localhost:5433/knowledge_brain
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
VOYAGE_API_KEY=pa-your-key-here
RERANKING_MODEL=rerank-2.5-lite
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_POOL=20
MCP_API_KEY=your-mcp-shared-secret-here
AZURE_LANGUAGE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=your-azure-language-key-here
APIM_GATEWAY_SECRET=your-apim-gateway-secret-here
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=knowledge-brain
REDIS_URL=redis://localhost:6380/0

# Document file storage (ADR-044). Locally, set only the connection string
# below — Azurite's own fixed, publicly-documented development account key,
# not a real secret. In production, leave this unset and set
# AZURE_STORAGE_ACCOUNT_URL instead; the backend authenticates with its
# Managed Identity there, no key needed at all.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER_NAME=documents
